<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.PlanstarApp" parent="Theme.MaterialComponents.DayNight.NoActionBar">
        <item name="colorPrimary">@color/primary</item>
        <item name="colorPrimaryDark">@color/primary_dark</item>
        <item name="colorAccent">@color/primary</item>
        <item name="android:textColorPrimary">@color/text_primary</item>
        <item name="android:textColorSecondary">@color/text_secondary</item>
        <item name="android:fontFamily">@font/yuewenfont_regular</item>
        <item name="android:windowBackground">@color/bg_grey</item>

        <!-- ===== 系统栏 / 安全区统一配置 =====
             内容统一绘制到系统栏后面（与 Android 15 强制 edge-to-edge 行为一致），
             各页面通过 insets padding 避让状态栏、刘海与导航栏。 -->
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:windowLightNavigationBar">true</item>
        <!-- 允许内容延伸到刘海/挖孔区域，具体避让由 insets 处理 -->
        <item name="android:windowLayoutInDisplayCutoutMode">shortEdges</item>
        <item name="android:windowActionModeOverlay">true</item>
    </style>
</resources>
